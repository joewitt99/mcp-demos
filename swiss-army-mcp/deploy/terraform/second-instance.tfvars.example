# Second swiss-army-mcp stack, alongside an existing one in the SAME account,
# region and VPC. Copy to xaa.tfvars (or terraform.tfvars in a separate copy of
# this directory) and fill in.
#
# Everything that must differ from the first stack is marked CHANGED.

aws_region = "us-east-1"

# ---- Stack name (CHANGED — drives every resource name) ----
name = "swiss-army-mcp-xaa"

# ---- DNS + TLS ----
hostname = "swiss-army-mcp-xaa.bridge.oktaproserv.com" # CHANGED

# Reuse the first stack's cert only if it covers this hostname (a wildcard
# *.bridge.oktaproserv.com does; a single-name cert does not — request a new
# one, or add this name as a SAN).
cert_arn       = "arn:aws:acm:us-east-1:<account>:certificate/<id>"
hosted_zone_id = "Z..." # same hosted zone as the first stack

# ---- VPC (SAME as the first stack — do not create a new one) ----
create_vpc        = false
vpc_id            = "vpc-..."
public_subnet_ids = ["subnet-aaa", "subnet-bbb"]
task_subnet_ids   = ["subnet-aaa", "subnet-bbb"]
assign_public_ip  = true # true when task_subnet_ids are public (no NAT)

# ---- Image ----
image_tag = "0.5.6"

# ---- SSM tenants prefix ----
# Leave commented to SHARE tenant configs with the first stack (same Okta
# tenants onboarded once, visible to both servers). Uncomment for an isolated
# set of tenants that must be onboarded separately at this host's /config.
# tenants_prefix = "/swiss-army-mcp-xaa/tenants/"
