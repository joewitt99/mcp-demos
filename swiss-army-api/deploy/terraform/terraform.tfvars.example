# Copy to terraform.tfvars and fill in.

aws_region = "us-east-1"

# ---- Stack name ----
# Prefixes every resource (ALB, target group, ECS cluster/service, IAM roles,
# SGs, log group). Must be unique per stack within an account+region, and
# must differ from the swiss-army-mcp stack if both share an account.
# name = "swiss-army-api"

# ---- DNS + TLS (existing) ----
hostname       = "swiss-army-api.bridge.oktaproserv.com"
cert_arn       = "arn:aws:acm:us-east-1:<account>:certificate/<id>"
hosted_zone_id = "Z..."

# ---- VPC ----
# Option A: let Terraform create a minimal demo VPC (1 VPC, IGW, 2 public
# subnets in different AZs). Comment out vpc_id / *_subnet_ids below.
#
# create_vpc          = true
# new_vpc_cidr        = "10.43.0.0/16"
# availability_zones  = ["us-east-1a", "us-east-1b"]   # required if your role denies ec2:DescribeAvailabilityZones

# Option B: bring your own VPC (e.g. the one swiss-army-mcp already uses).
vpc_id            = "vpc-..."
public_subnet_ids = ["subnet-aaa", "subnet-bbb"]
task_subnet_ids   = ["subnet-aaa", "subnet-bbb"]
assign_public_ip  = true   # true when task_subnet_ids are public (no NAT)

# ---- Image ----
# image_repository = "joewitt99/swiss-army-api"
image_tag = "1.0.0"

# ---- SSM tenants prefix (default is fine for most setups) ----
# Customers configure their Okta settings at https://<hostname>/config; they
# persist here. Don't share swiss-army-mcp's prefix (different schema).
# tenants_prefix = "/swiss-army-api/tenants/"
